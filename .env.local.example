# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# SMTP credentials used to send the contact form to your inbox.
# Works with Gmail (use an App Password, not your login password),
# Zoho, Outlook, or any SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-app-password

# Optional: defaults to SMTP_USER if not set.
SMTP_FROM=you@example.com

# Where contact form submissions get delivered.
CONTACT_TO_EMAIL=jashne.ali@apponward.com
